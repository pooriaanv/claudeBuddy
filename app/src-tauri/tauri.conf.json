{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeBuddy",
  "version": "0.3.0",
  "identifier": "com.pooria.claudebuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:notify && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDNzdEMURGRERFRTk0MkUKUldRdWxPN2QzOUYzVEt1T2tBcE9FWjEwUXlpZXlCMzhCalhqQ3YwUm1seUROdHZJNDVnMFBTcTIK",
      "endpoints": [
        "https://github.com/pooriaanv/claudeBuddy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pet and settings windows: events, the prefs store, open-at-login. App commands need no permission entry.",
  "windows": ["pet", "settings"],
  "permissions": [
    "core:event:default",
    "core:app:default",
    "core:window:allow-set-title",
    "store:default",
    "autostart:default",
    "updater:default",
    "process:allow-restart"
  ]
}
